FROM quay.io/centos/centos:stream10

RUN dnf config-manager --set-enabled crb

RUN dnf update -y && \
    dnf install -y \
        wget \
        ca-certificates \
        unzip \
        which \
        gcc \
        gcc-c++ \
        libstdc++ \
        libstdc++-devel \
        libstdc++-static \
        protobuf-compiler \
        protobuf-devel \
        rpm \
        cpio \
        java-21-openjdk-devel \
        git \
        rpm-build

RUN wget https://github.com/bazelbuild/bazel/releases/download/8.3.1/bazel-8.3.1-installer-linux-x86_64.sh

RUN chmod +x ./bazel-8.3.1-installer-linux-x86_64.sh && ./bazel-8.3.1-installer-linux-x86_64.sh

RUN rm -f ./bazel-8.3.1-installer-linux-x86_64.sh && \
    mkdir /app

# Verify installation
RUN bazel --help

WORKDIR /app
CMD ["/bin/bash"]

